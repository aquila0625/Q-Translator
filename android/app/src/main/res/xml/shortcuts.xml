            android:targetClass="com.yishulabs.qtranslator.MainActivity"
            android:targetPackage="com.yishulabs.qtranslator">
            <extra android:name="type" android:value="face" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="practice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_practice"
        android:shortcutShortLabel="@string/shortcut_practice">
        <intent
            android:action="com.yishulabs.qtranslator.SHORTCUT"
            android:targetClass="com.yishulabs.qtranslator.MainActivity"
            android:targetPackage="com.yishulabs.qtranslator">
            <extra android:name="type" android:value="practice" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="new"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new"
        android:shortcutShortLabel="@string/shortcut_new">
        <intent
            android:action="com.yishulabs.qtranslator.SHORTCUT"
            android:targetClass="com.yishulabs.qtranslator.MainActivity"
            android:targetPackage="com.yishulabs.qtranslator">
            <extra android:name="type" android:value="new" />
        </intent>
    </shortcut>
</shortcuts>
